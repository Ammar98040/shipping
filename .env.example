# التشغيل
DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# رابط النطاق العام المستخدم في روابط المشاركة (منتج/سلة) — اتركه فارغاً للتطوير المحلي
# مثال: PUBLIC_BASE_URL=https://shop.example.com
PUBLIC_BASE_URL=

# قاعدة البيانات
USE_SQLITE=True
# USE_SQLITE=False
# DB_NAME=shop_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ——— أمان الإنتاج ———
# عند DEBUG=False يُفعّل تلقائياً: HTTPS، كوكيز آمنة، HSTS (انظر config/settings.py)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# طول كلمة المرور الأدنى (افتراضي 10)
# AUTH_PASSWORD_MIN_LENGTH=10

# حد محاولات تسجيل الدخول (لكل بوابة)
# LOGIN_FAILURE_MAX=5
# LOGIN_FAILURE_LOCK_SECONDS=900
# LOGIN_FAILURE_WINDOW_SEC=3600
# بعد هذا العدد من الفشل من نفس IP يُطلب Turnstile على شاشة الدخول
# LOGIN_CAPTCHA_AFTER_FAILS=3

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# اتركهما فارغين في التطوير لتعطيل الكابتشا؛ في الإنتاج يُنصح بتعيينهما
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# بريد تنبيه عند دخول ناجح لحساب المتجر (اختياري)
SEND_LOGIN_ALERT_EMAIL=False

# جلسة «تذكرني» — الحد الأقصى بالثواني عند تفعيل خانة تذكرني (افتراضي 14 يوم)
# SESSION_COOKIE_AGE=1209600

# إعادة تعيين كلمة المرور + OTP التسجيل
# PASSWORD_RESET_EMAIL_MAX=5
# PASSWORD_RESET_IP_MAX=40
# REGISTER_OTP_EMAIL_MAX=5
# REGISTER_OTP_IP_MAX=20

# البريد — افتراضي المشروع: console (يظهر OTP وغيره في تيرمنال التشغيل)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@shop.local
# للإنتاج: django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=...
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...

FAKE_GATEWAY_WEBHOOK_SECRET=dev-secret-gateway
FAKE_SHIPPING_WEBHOOK_SECRET=dev-secret-shipping
# في الإنتاج (DEBUG=False) لا تُستخدم القيم أعلاه الافتراضية — عيّن أسراراً عشوائية قوية.

# كاش Redis للإنتاج مع عدة عمال (اختياري؛ بدونها يُستخدم LocMem)
# REDIS_URL=redis://127.0.0.1:6379/1

# حدود صور الدردشة وخدمة العملاء (بايت / عدد ملفات لكل طلب)
# CHAT_IMAGE_MAX_BYTES=5242880
# CHAT_IMAGE_MAX_COUNT=10

DELIVERY_FEE=15

# ——— نسخ احتياطي ZIP (سوبر يوزر في /manage/system/backup/) ———
# مستخدمون لا يُستبدلون من ملف النسخة عند الاستيراد (يبقى حسابهم الحالي وكلمة المرور الحالية).
# أسماء مستخدمين إضافيين لا يُستبدلون من ملف النسخة (إلى جانب SYSTEM_IMMUTABLE_USERNAMES في settings.py).
# BACKUP_PROTECTED_USERNAMES=
# كلمة سر أولية عند غياب أحد المحميين وقت الاستيراد فقط (لا تُستخدم إذا كان الحساب موجوداً).
# BACKUP_PROTECTED_BOOTSTRAP_PASSWORD=
# مسار مجلد لحفظ نسخة أمان تلقائية قبل الاستيراد (اختياري؛ والّا يُستخدم مجلد النظام المؤقت).
# BACKUP_AUTO_SAVE_DIR=
# حجم أقصى لرفع ZIP بالاستيراد (ميجابايت)
# BACKUP_IMPORT_MAX_MB=2048
# السماح بالاستيراد الكامل من الواجهة على MySQL (افتراضياً غير مفعّل — خطر أعلى).
# BACKUP_WEB_RESTORE_ALLOW_MYSQL=False
# سر حذف النظام بالكامل (يجب أن يطابق ما تدخله في حقل كلمة سر الحذف). اتركه فارغاً لتعطيل الزر.
# FULL_SITE_WIPE_SECRET=
